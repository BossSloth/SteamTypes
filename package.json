{
  "name": "steam-types",
  "version": "2.3.0",
  "description": "TypeScript type definitions for the Steam client",
  "keywords": [
    "definitions",
    "interface",
    "steam",
    "types",
    "typescript",
    "valve"
  ],
  "license": "MIT",
  "author": "BossSloth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BossSloth/SteamTypes.git"
  },
  "files": [
    "dist",
    "src",
    "patches",
    "global-overrides.d.ts"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./Global/*": "./dist/types/Global/*.js",
    "./Modules/*": "./dist/types/Modules/*.js",
    "./Protobufs/*": "./dist/types/Protobufs/*.js",
    "./Runtime/*": "./dist/Runtime/*.js",
    "./*": "./dist/*.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "postinstall": "bun scripts/strip-steambrew-globals.ts || true",
    "build": "rm -rf dist && tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "watch": "tsc -w --project tsconfig.build.json",
    "build-convert-debug": "esbuild scripts/convert-to-typescript/index.ts --bundle --format=iife --platform=browser --outfile=build/scripts/convert-to-typescript.js",
    "build-convert": "bun build-convert-debug --minify-identifiers --minify-syntax",
    "validate-types": "bun scripts/validate-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "lint": "knip ; oxlint && echo 'Lint passed'",
    "lint:fix": "knip --fix ; oxlint --fix",
    "format": "oxfmt",
    "typecheck": "bun check -p ./src && bun check -p ./scripts",
    "prepublishOnly": "bun run build",
    "proto:generate": "bun run scripts/proto-scripts/generate-protobufs.ts",
    "proto:watch": "bun run --watch scripts/proto-scripts/generate-protobufs.ts"
  },
  "dependencies": {
    "@tanstack/query-core": "^5.104.5",
    "@types/google-protobuf": "^3.15.12",
    "@types/history": "~4.7.11",
    "long": "^5.3.2",
    "mobx": "^6.16.1"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@steambrew/client": "^5.8.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.4.3",
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "5.0.5",
    "ansi-regex": "^6.4.0",
    "chalk": "^6.0.1",
    "chrome-remote-interface": "^0.34.0",
    "cli-progress": "^3.12.0",
    "commander": "^15.0.0",
    "dedent": "^1.7.2",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.4.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "knip": "^6.42.1",
    "natural-orderby": "^5.0.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "protobufjs": "^8.8.1",
    "semantic-release": "^25.0.9",
    "strip-ansi": "^7.2.0",
    "ts-morph": "28.0.0",
    "tsc-alias": "^1.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@steambrew/client": "^5.8.5"
  },
  "peerDependenciesMeta": {
    "@steambrew/client": {
      "optional": true
    }
  }
}
